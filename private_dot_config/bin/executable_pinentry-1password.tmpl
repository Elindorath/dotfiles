#!/bin/sh

if [ -z "${OP_PIN_ITEM}" ]; then
  echo "error: OP_PIN_ITEM is not set"
  exit 1
fi

echo "OK"

while read cmd rest; do
  echo "cmd=${cmd} rest=${rest}" >&2
  echo "cmd=${cmd} rest=${rest}" >> "${PINENTRY_LOG}"

  case "${cmd}" in
    \#*)
      echo "OK"
      ;;
    GETPIN)
      {{ if (.wsl) -}}
      PASSPHRASE=$({{ output "wslpath" (output "wslvar" "ChocolateyInstall" | trim) | trim }}/bin/op.exe read "${OP_PIN_ITEM}")
      {{- else -}}
      PASSPHRASE=$(op read "${OP_PIN_ITEM}")
      {{- end }}
      echo "D ${PASSPHRASE}"
      echo "OK"
      ;;
    BYE)
      echo "OK"
      exit 0
      ;;
    *)
      echo "OK"
      ;;
  esac
done
