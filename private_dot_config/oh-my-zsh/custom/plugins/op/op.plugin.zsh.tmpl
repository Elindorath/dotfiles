#! /usr/bin/env zsh
# shellcheck shell=bash

{{- $executable := "op" -}}
{{- $test_custom_location := "" -}}

{{ if (.wsl) -}}
{{-   $executable = "/mnt/c/ProgramData/chocolatey/bin/op.exe" -}}
{{-   $test_custom_location = print "&& [ ! -f \"" $executable "\" ]" -}}
{{- end }}

if (( ! $+commands[op] )) {{ $test_custom_location }}; then
  return
fi

# If the completion file doesn't exist yet, we need to autoload it and
# bind it to `op`. Otherwise, compinit will have already done that.
if [[ ! -f "$ZSH_CACHE_DIR/completions/_op" ]]; then
  typeset -g -A _comps
  autoload -Uz _op
  _comps[op]=_op
fi

# `$commands[op]` is empty when the executable is the WSL one, hence the fallback.
op_bin="${commands[op]:-{{ $executable }}}"

# Only regenerate when missing or older than the binary: `op completion` takes ~90 ms.
if [[ ! -f "$ZSH_CACHE_DIR/completions/_op" || "$op_bin" -nt "$ZSH_CACHE_DIR/completions/_op" ]]; then
  "$op_bin" completion zsh >| "$ZSH_CACHE_DIR/completions/_op" &|
fi

unset op_bin
