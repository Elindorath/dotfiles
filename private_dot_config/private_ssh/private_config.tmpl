Host *
  AddKeysToAgent yes
{{- if (eq .chezmoi.os "darwin") }}
  UseKeychain yes
{{- end }}
  HashKnownHosts yes
  UserKnownHostsFile ${XDG_CONFIG_HOME}/ssh/known_hosts

Host github.com
  AddKeysToAgent yes
  IdentityFile ${XDG_CONFIG_HOME}/ssh/github_ed25519

Host gitlab.com
  AddKeysToAgent yes
  IdentityFile ${XDG_CONFIG_HOME}/ssh/gitlab_rsa
