#! /usr/bin/env zsh
# shellcheck shell=bash

DEFAULT_USER="$USER"

{{ if (.wsl) -}}
# Make `code` available in the path
path=("{{ .win_home }}/AppData/Local/Programs/Microsoft VS Code/bin" $path)
# Make `cursor` available in the path
path=("{{ .win_home }}/AppData/Local/Programs/cursor/resources/app/bin" $path)
export WIN_HOME="{{ .win_home }}"
{{- end }}

path=("${XDG_BIN_HOME}" $path)
path=("${XDG_CONFIG_HOME}/bin" $path)

# ----- Oh My Zsh settings ----- #

export ZSH="${XDG_CONFIG_HOME}/oh-my-zsh"

# Generated from .chezmoidata/zsh.yaml, which is also what limits the plugins
# downloaded by the oh-my-zsh external. Edit the list there, not here.
plugins=(
{{- range .zsh.plugins }}
{{- /* `get` is required over `.os`: chezmoi errors out on a missing map key. */}}
{{-   $os := get . "os" }}
{{-   if or (not $os) (eq $os $.chezmoi.os) }}
{{-     range (dig "comments" (list) .) }}
  # {{ . }}
{{-     end }}
{{-     if get . "disabled" }}
  # {{ .name }}
{{-     else }}
  {{ .name }}
{{-     end }}
{{-   end }}
{{- end }}
)

ZSH_CUSTOM="$ZSH/custom"

ZSH_CACHE_DIR="${XDG_CACHE_HOME}/oh-my-zsh"

zstyle ":omz:update" mode disabled

ZSH_DISABLE_COMPFIX="false"

COMPLETION_WAITING_DOTS="true"

DISABLE_AUTO_TITLE="false"

CASE_SENSITIVE="false"

HYPHEN_INSENSITIVE="true"

DISABLE_MAGIC_FUNCTIONS="false"

DISABLE_LS_COLORS="false"

# Disabled because it asks to autocorrect false positive (e.g.: chezmoi git ...)
ENABLE_CORRECTION="false"

DISABLE_UNTRACKED_FILES_DIRTY="false"

HIST_STAMPS="%Y/%m/%d"

# ZSH_THEME_RANDOM_CANDIDATES=("robbyrussell" "agnoster")

# ZSH_THEME_RANDOM_IGNORED=("agnoster" "pygmalion" "rkj")

# ZSH_THEME_RANDOM_QUIET="false"

DISABLE_AUTO_UPDATE=true

# Required for the zsh-completions plugin to work with oh-my-zsh
# See: https://github.com/zsh-users/zsh-completions/issues/603
fpath+="${ZSH_CUSTOM:-${ZSH:-~/.oh-my-zsh}/custom}/plugins/zsh-completions/src"

fpath+="${HOMEBREW_PREFIX}/share/zsh/site-functions"

# Specific to the ssh-agent plugin
zstyle :omz:plugins:ssh-agent identities ${XDG_CONFIG_HOME}/ssh/{github_ed25519,gitlab_rsa,bastion_ed25519}
{{- if (eq .chezmoi.os "darwin") }}
zstyle :omz:plugins:ssh-agent ssh-add-args --apple-use-keychain
{{- end }}
zstyle :omz:plugins:ssh-agent quiet yes

# shellcheck source=/home/elindorath/.oh-my-zsh/oh-my-zsh.sh
source "$ZSH/oh-my-zsh.sh"

# The following settings must be set after Oh My Zsh has been sourced

ZSH_THEME_TERM_TITLE_IDLE="%n@%m:%~"

ZSH_THEME_TERM_TAB_TITLE_IDLE="%15<..<%~%<<"

ZSH_COLORIZE_TOOL=chroma

# ----- Oh My Zsh settings ----- #



# ----- Custom plugins ----- #

# shellcheck source=/home/elindorath/.config/oh-my-zsh/custom/plugins/zsh-change-case/change-case.zsh
source "$ZSH_CUSTOM/plugins/zsh-change-case/change-case.zsh"

# ----- Custom plugins ----- #



# ----- Native zsh settings ----- #

HISTFILE="${XDG_STATE_HOME}/zsh/.zsh_history"
HISTORY_IGNORE="(clear|k)"
# The number of commands to load in memory
HISTSIZE=1000000000
# The number of commands to store in the history file
SAVEHIST=1000000000
LANG="en_US.UTF-8"
# The command to use for redirection of stdout (>) without command
NULLCMD="cat"
# The command to use for redirection of stdin (<) without command
READNULLCMD="less"

watch=(notme)
WATCHFMT="%n has %a %l from %M at %T %D{%Y/%m/%d}"

setopt EXTENDED_HISTORY
setopt HIST_FIND_NO_DUPS
setopt HIST_IGNORE_DUPS
setopt NO_HIST_IGNORE_SPACE
setopt NO_HIST_IGNORE_ALL_DUPS
setopt NO_HIST_EXPIRE_DUPS_FIRST
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt NO_INC_APPEND_HISTORY
setopt NO_INC_APPEND_HISTORY_TIME
setopt SHARE_HISTORY
setopt HIST_ALLOW_CLOBBER
# Zsh options
setopt AUTO_CD
setopt AUTO_PUSHD
setopt NOCLOBBER
setopt INTERACTIVE_COMMENTS

# ----- Native zsh settings ----- #



# ----- Custom ----- #

{{ if (eq .chezmoi.os "darwin") -}}
iterm2_integration_path="${XDG_CONFIG_HOME}/iterm2/integration"

[ -e "${iterm2_integration_path}/shell_integration/zsh" ] && source "${iterm2_integration_path}/shell_integration/zsh"

path=("${iterm2_integration_path}/utilities" $path)
{{- end }}

path=("${XDG_CONFIG_HOME}/git" $path)

# Specific to zsh-mask plugin
export HISTORY_EXCLUDE_PATTERN="${HISTORY_EXCLUDE_PATTERN}|BW_SESSION[=:] *([^ ]+)|bw +unlock +([^ ]+)"

# Replaces the oh-my-zsh `gpg-agent` plugin. This plugin tests if we use ssh support from gpg.
# As we use ssh-agent, we don't need to use gpg-agent for ssh.
# The plugin also sets a hook that only matters for a TTY-based pinentry, which we don't use.
export GPG_TTY=$TTY

# Specific to zsh-z plugin
export ZSHZ_DATA="${XDG_CONFIG_HOME}/z/database"
export ZSHZ_TILDE=1

# Specific to zsh-autocomplete
zstyle ':autocomplete:*' ignored-input '..##'
zstyle ':autocomplete:*' recent-dirs zsh-z
zstyle ':autocomplete:*' insert-unambiguous yes
zstyle ':autocomplete:*' widget-style menu-select
zstyle ':autocomplete:*' fzf-completion yes

zle -A {.,}history-incremental-search-forward
zle -A {.,}history-incremental-search-backward

# Specific to the less pager
export LESSHISTFILE="${XDG_STATE_HOME}/less/history"

# Specific to node
export NODE_REPL_HISTORY="${XDG_STATE_HOME}/node/repl_history"
# Specific to npm
export NPM_CONFIG_CACHE="${XDG_CACHE_HOME}/npm"
# Specific to node-gyp
# Will stop working in the next npm version
# See: https://github.com/nodejs/node-gyp/issues/3156
export NPM_CONFIG_DEVDIR="${XDG_CACHE_HOME}/node-gyp"

# Specific to vim
export VIMINIT="source ${XDG_CONFIG_HOME}/vim/vimrc"

# Specific to ssh
# Yarn sets its own GIT_SSH_COMMAND, overriding any git configuration, so this is
# the only hook to make a git operation it spawns fail fast rather than wait on a prompt.
# See: https://github.com/yarnpkg/yarn/blob/6db39cf0ff684ce4e7de29669046afb8103fce3d/src/util/git/git-spawn.js
alias yarn="GIT_SSH_COMMAND=\"ssh -oBatchMode=yes\" yarn"

# Specific to AWS
export AWS_CONFIG_FILE="${XDG_CONFIG_HOME}/aws/config"

# Required for installing python
export LDFLAGS="-L${HOMEBREW_PREFIX}/lib -L${HOMEBREW_PREFIX}/opt/openssl@3/lib -L${HOMEBREW_PREFIX}/opt/tcl-tk/lib"
export CPPFLAGS="-I${HOMEBREW_PREFIX}/include -I${HOMEBREW_PREFIX}/opt/openssl@3/include -I${HOMEBREW_PREFIX}/opt/tcl-tk/include -I${HOMEBREW_PREFIX}/opt/tcl-tk/include/tcl-tk"
export CFLAGS="-I${HOMEBREW_PREFIX}/include -I${HOMEBREW_PREFIX}/opt/openssl@3/include -I${HOMEBREW_PREFIX}/opt/tcl-tk/include -I${HOMEBREW_PREFIX}/opt/tcl-tk/include/tcl-tk"
path=("${HOMEBREW_PREFIX}/opt/tcl-tk/bin" $path)
export PKG_CONFIG_PATH="${HOMEBREW_PREFIX}/opt/tcl-tk/lib/pkgconfig"
export PYTHON_CONFIGURE_OPTS="--with-tcltk-includes='-I${HOMEBREW_PREFIX}/opt/tcl-tk/include' --with-tcltk-libs='-L${HOMEBREW_PREFIX}/opt/tcl-tk/lib -ltcl8.6 -ltk8.6'"
export CONFIGURE_OPTS="--with-system-expat --with-openssl=${HOMEBREW_PREFIX}/opt/openssl/ --with-ssl-default-suites=openssl"

# Specific to Ansible
export ANSIBLE_HOME="${XDG_CONFIG_HOME}/ansible"

# Specific to ruby
export RUBY_CONFIGURE_OPTS="--with-openssl-dir=${HOMEBREW_PREFIX}/opt/openssl@3"

{{ if (eq .chezmoi.os "darwin") -}}
# Specific to android
export ANDROID_HOME="$HOME/Library/Android/sdk"
{{- end }}

# ----- Custom ----- #



# ----- Aliases ----- #

# See useful aliases at:
# - https://github.com/ohmyzsh/ohmyzsh/blob/master/plugins/common-aliases/common-aliases.plugin.zsh
# - https://github.com/ohmyzsh/ohmyzsh/blob/master/plugins/cp/cp.plugin.zsh

# Define an alias to git clone then cd into it
# Define an alias to mkdir then cd into it

alias timestamp="date +%s"
alias k=clear

{{- if (eq .chezmoi.os "linux") }}
alias open="xdg-open"
{{- end }}

alias myip="dig @resolver4.opendns.com myip.opendns.com +short -4"

# Should be declared in $ZSH_CUSTOM/from.zsh
from() { ls -la "$(which "$1")"; }

alias -g G="| grep"
alias -g Gi="| grep -i"

alias dc="docker compose"

# chezmoi aliases
alias dot="{{ .editor_command }} $(chezmoi source-path)"
alias dotg="chezmoi git --"
alias dots="chezmoi git -- status"
alias dotd="chezmoi git -- diff"
alias dota="chezmoi git -- add"
alias dotc="chezmoi git -- commit"
alias dotp="chezmoi git -- push"
alias dotpl="chezmoi git -- pull"

# Specific to bat
# Replace cat with bat
alias cat="bat --paging=never"
alias -g -- --help="--help | bat --plain --language=help"

# Replace ls and tree commands with eza
alias ls="eza --icons"
alias la="eza --icons --all"
alias l="eza --icons --all --long --group --header"
alias ll="eza --icons --long --group --header"
alias tree="eza --tree"
alias treee="eza --tree --icons --all --level 1 --classify"

{{ if (eq .chezmoi.os "darwin") -}}
# Required by pinentry-touchid
alias pinentry="pinentry-mac"
{{- end }}

# Tied path to the PATH variable, ensure path entries are deduplicated and export `PATH`
typeset -TUx PATH path

# ----- Aliases ----- #

eval "$(oh-my-posh init zsh --config ${XDG_CONFIG_HOME}/oh-my-posh/elindorath.omp.yml)"
